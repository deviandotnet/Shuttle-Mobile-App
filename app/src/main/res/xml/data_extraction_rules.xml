<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Encrypted session/token store: its Keystore key is never backed up, so a restored copy can't be decrypted. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="session_prefs.xml"/>
        <exclude domain="sharedpref" path="db_key_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session_prefs.xml"/>
        <exclude domain="sharedpref" path="db_key_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
